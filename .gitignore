# 토큰·시크릿. 인스타그램 발행 토큰(IG_ACCESS_TOKEN)과 앱 시크릿이 여기 산다.
# 한 번 커밋되면 깃 기록에서 지우기가 어렵고, 공개 저장소라 그 즉시 노출이다.
# .env.example 만 추적한다(값 없는 서식).
.env
.env.*
!.env.example

pipeline/keywords.json
pipeline/candidates.json
pipeline/selected.json
pipeline/cards.json
pipeline/media.json
# translator scratch files (translate.py jobs/apply); .retry.json variants match too
pipeline/jobs_*.json
pipeline/answers_*.json
# Track card/banner image + video-clip files (referenced by axbrief-data.js) but
# ignore any other build junk that lands under pipeline/media/. Note: the raw
# downloaded source clips (<id>.src.*) stay ignored — only the encoded outputs
# (<id>.mp4 / <id>.webm) and stills are tracked.
pipeline/media/**
!pipeline/media/**/
!pipeline/media/**/*.jpg
!pipeline/media/**/*.jpeg
!pipeline/media/**/*.png
!pipeline/media/**/*.svg
!pipeline/media/**/*.webp
!pipeline/media/**/*.mp4
!pipeline/media/**/*.webm
pipeline/media/**/*.src.*
pipeline/runs/

.DS_Store
**/.DS_Store
.playwright-mcp/
pipeline/candidates_filtered.json

__pycache__/
**/__pycache__/
pipeline/seed/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
node_modules/
.wrangler/
.dev.vars
