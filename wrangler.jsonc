{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axitnow",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "main": "worker/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "axitnow.com", "custom_domain": true },
    { "pattern": "www.axitnow.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/premium/*", "/", "/index.html",
                         "/en", "/ko", "/ja", "/zh", "/es",
                         "/en/*", "/ko/*", "/ja/*", "/zh/*", "/es/*"]
  },
  "vars": {
    "BASE_URL": "https://axitnow.com",
    "I18N_MENU": "1",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "",
    "PADDLE_PRICE_MONTHLY": "",
    "PADDLE_PRICE_YEARLY": "",
    // 버튼에 표시할 금액. Paddle에서 가격이 바뀌면 배포 없이 여기만 고친다.
    // 금액만 둔다 — '월/연' 같은 주변 문구는 i18n의 틀(paywall.plan_*_fmt)이 갖는다.
    "PADDLE_PRICE_MONTHLY_AMOUNT": "$5.99",
    "PADDLE_PRICE_YEARLY_AMOUNT": "$59.99"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "axbrief-subscribers", "database_id": "a82e6d9c-8393-4a6e-9d7b-4cfcbe08ea44" }
  ],
  "kv_namespaces": [
    { "binding": "AUTH_TOKENS", "id": "075a714ceb014be0a95ee4ff01442991" }
  ]
}
