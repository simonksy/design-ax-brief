# 인스타그램 발행용 비밀값. 이 파일을 .env.local 로 복사해 값을 채운다.
#   cp .env.example .env.local
# .env* 는 .gitignore에 있으므로 .env.local 은 커밋되지 않는다.
# 값은 Meta 앱 대시보드 > Instagram > API setup with Instagram login 에서 얻는다.

IG_APP_ID=
IG_APP_SECRET=
# 장기 토큰(60일). 만료 전에 갱신해야 한다.
IG_ACCESS_TOKEN=
# @axitnow 의 Instagram 사용자 ID (토큰 생성 화면에 같이 나온다)
IG_USER_ID=
